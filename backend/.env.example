# ===== 本地开发配置示例（复制成 .env 使用）=====
# Docker Compose 部署时不需要这个文件，配置直接写在 compose 的 environment 里。

# --- 数据库 ---
# 想零依赖快速体验：用 SQLite（读写同一个文件）
DB_WRITE_URL=sqlite:///./demo.db
DB_READ_URL=sqlite:///./demo.db

# 想连真实 MySQL（本地先起一个 mysql:8.0）：
# DB_WRITE_URL=mysql+pymysql://demo:demo123@localhost:3306/fullstack_demo
# DB_READ_URL=mysql+pymysql://demo:demo123@localhost:3306/fullstack_demo

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
# 带密码时：REDIS_URL=redis://:redispass@localhost:6379/0

# --- Session 存储后端 ---
# redis  : 集中式（正确示范，集群必须用这个）
# memory : 进程内存（错误示范，仅用于复现「集群掉登录」）
SESSION_BACKEND=redis
SESSION_TTL_SECONDS=1800

# --- Cookie ---
# 本地 HTTP 必须是 false；上了 HTTPS 改成 true
COOKIE_SECURE=false

# --- CORS ---
# 本地开发时前端跑在 5173，需要放行；生产走 Nginx 同源，用不到 CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# --- 实例标识（集群里用来区分副本，Docker 中由 compose 覆盖）---
INSTANCE_ID=local-dev
