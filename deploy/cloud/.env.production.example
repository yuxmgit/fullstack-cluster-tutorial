# ============================================================
#  腾讯云生产环境变量模板
#
#  用法：
#    1. cp .env.production.example .env
#    2. 按下面注释填好每一项（尤其是 5 个密码）
#    3. chmod 600 .env        ← 只有 root 可读
#
#  ⚠️ 三条铁律：
#    * 这个 .env 绝不提交到 Git（.gitignore 已忽略）
#    * 密码只用「大小写字母 + 数字」，避免 @ : / ? # 等字符破坏连接串
#    * 所有 CHANGE_ME 必须换掉，禁止照抄模板上线
#
#  生成密码：
#    openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24
# ============================================================

# ---------- 1. 域名（必填）----------
# 已经解析到服务器公网 IP 的域名，不要带 https://
# 例：app.example.com
DOMAIN=CHANGE_ME.example.com

# ---------- 2. MySQL ----------
MYSQL_DATABASE=fullstack_demo
MYSQL_USER=appuser
MYSQL_PASSWORD=CHANGE_ME_mysql_app_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
# 主从复制专用账号（不要和业务账号共用）
MYSQL_REPL_PASSWORD=CHANGE_ME_repl_password

# ---------- 3. Redis ----------
REDIS_PASSWORD=CHANGE_ME_redis_password

# ---------- 4. 首个管理员 ----------
# SEED_DEMO_USERS=false 时，首次启动会用它创建 admin 账号
# 登录后请立刻在数据库里改成你自己的强密码（项目暂未提供改密接口）
SEED_DEMO_USERS=false
ADMIN_INITIAL_PASSWORD=CHANGE_ME_admin_password

# ---------- 5. 应用行为 ----------
# Session 空闲过期时间（秒）。1800 = 30 分钟
SESSION_TTL_SECONDS=1800
# 生产必须关闭调试接口（/api/auth/session 会返回会话原文）
ENABLE_DEBUG_ENDPOINTS=false
TZ=Asia/Shanghai

# ---------- 6. 镜像与发布 ----------
# 单机部署用 latest 即可；接入腾讯云 TCR 后改为 registry.example.com/ns/project
IMAGE_PREFIX=
# 每次发布自动生成的版本号（deploy.sh 会覆盖，一般不用手改）
TAG=latest

# ---------- 7. 备份 ----------
# 本地保留天数
BACKUP_KEEP_DAYS=7
# 是否在上传前先把已有备份同步到腾讯云 COS（需要先安装 coscli 并配置）
BACKUP_TO_COS=false
COS_BUCKET=
