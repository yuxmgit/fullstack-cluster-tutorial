# ============================================================
#  生产 Nginx（HTTPS + 负载均衡）
#
#  这个文件挂载到 /etc/nginx/templates/default.conf.template，
#  nginx 官方镜像启动时会用 envsubst 把 ${DOMAIN} 换成真实域名，
#  再输出到 /etc/nginx/conf.d/default.conf。
#
#  为什么用模板而不是直接写死域名：
#    同一个镜像/配置，换域名只改 .env，不用改配置文件，也不用手工 sed。
# ============================================================

upstream backend_pool {
    # 轮询；某台连续失败 3 次后摘除 10 秒再试
    server backend-1:8000 max_fails=3 fail_timeout=10s;
    server backend-2:8000 max_fails=3 fail_timeout=10s;
    server backend-3:8000 max_fails=3 fail_timeout=10s;

    keepalive 32;
}

# ---------- 限流：防止单 IP 打爆后端 ----------
# rate=20r/s 表示每个 IP 每秒 20 个请求；burst 允许瞬时突发。
# 注意：Session 存在 Redis 后，接口本身是无状态的，限流可以按 IP 做。
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=conn_limit:10m;

log_format main '$remote_addr - [$time_local] "$request" $status '
                '$body_bytes_sent up=$upstream_addr rt=$request_time';

# ---------- HTTP：只做证书校验与跳转 ----------
server {
    listen 80;
    server_name ${DOMAIN};

    # Let's Encrypt / acme.sh 的 HTTP-01 校验路径，必须能在 80 端口访问
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 其它一律跳到 HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- HTTPS：真正的业务入口 ----------
server {
    listen 443 ssl;
    http2 on;

    server_name ${DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_prefer_server_ciphers off;

    # 安全响应头。HSTS 一旦下发，浏览器会强制走 HTTPS，
    # 所以务必确认证书没问题再长期保留这一行。
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 10m;

    access_log /var/log/nginx/access.log main;
    error_log  /var/log/nginx/error.log warn;

    # 单 IP 最多 20 个并发连接
    limit_conn conn_limit 20;

    # 健康检查（给负载均衡/监控用，不写访问日志）
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # 生产环境建议关闭接口文档，需要时临时注释掉这一行
    # location = /docs { return 404; }

    # ---------- API → 后端集群 ----------
    location /api/ {
        limit_req zone=api_limit burst=40 nodelay;

        proxy_pass http://backend_pool;

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # 后端靠这个头判断"原始请求是不是 HTTPS"，
        # 与 Cookie Secure 属性配合才不会误判协议。
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 3s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;

        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # ---------- 页面 → 前端容器 ----------
    location / {
        proxy_pass http://frontend:80;
        proxy_set_header Host            $host;
        proxy_set_header X-Real-IP       $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
