# ============================================================
#  Redis 生产模板
#
#  deploy.sh 会用 envsubst 把 ${REDIS_PASSWORD} / ${REDIS_MAXMEMORY}
#  替换成 .env 里的真实值，输出到 deploy/cloud/runtime/redis.conf。
#
#  为什么不在 compose 里直接写 --requirepass：
#    docker inspect 会把命令行完整打印出来，等于把密码贴在你脸上。
# ============================================================

bind 0.0.0.0
port 6379
protected-mode yes

# 密码由 .env 生成，绝不写死在仓库里
requirepass ${REDIS_PASSWORD}

# ---------- 内存 ----------
maxmemory ${REDIS_MAXMEMORY}
# Session 都是可再生数据（用户重新登录即可），用 allkeys-lru 最安全
maxmemory-policy allkeys-lru

# ---------- 持久化 ----------
appendonly yes
appendfsync everysec
appendfilename "appendonly.aof"
dir /data

save 900 1
save 300 10
save 60 10000

# ---------- 日志 ----------
loglevel notice
